---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Nav from "../../../../components/Nav.astro";
import MetadataItem from "../../../../components/photos/MetadataItem";
import { NavArrowOverlay } from "../../../../components/photos/PhotoImage/NavArrowOverlay";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { getGalleryImageModule } from "../../../../lib/images";
import { getShutterFractionFromExposureTime, round } from "../../../../utils";
import { parseAbsoluteToLocal } from "@internationalized/date";
import "../../../../components/photos/PhotoImage/PhotoImage.css";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  return photos.map((photo) => {
    const { yearFolder, monthSlug } = photo.data.organization;
    const monthName = monthSlug.includes("/") ? monthSlug.split("/")[1] : yearFolder;
    return {
      params: {
        year: yearFolder,
        month: monthName,
        filename: photo.data.filename,
      },
      props: { photo },
    };
  });
}

const { photo } = Astro.props;
const { meta, dateTaken, slug, filename } = photo.data;

// Get optimized full-size image
const imageModule = getGalleryImageModule(filename);
let imageSrc = "";
let imageWidth = 0;
let imageHeight = 0;
if (imageModule) {
  const optimized = await getImage({
    src: imageModule,
    width: 3000,
  });
  imageSrc = optimized.src;
  imageWidth = optimized.attributes.width as number;
  imageHeight = optimized.attributes.height as number;
}

// Get original file URL for download (copy to public at build time)
const downloadUrl = `/gallery/${photo.data.relativePath}`;

// Compute shutter speed
const shutterSpeed = meta.ExposureTime
  ? getShutterFractionFromExposureTime(meta.ExposureTime)
  : null;

// Parse date
const dt = dateTaken ? parseAbsoluteToLocal(dateTaken) : null;
const dateStr = dt
  ? dt.toDate().toLocaleDateString("en-US", {
      timeZone: meta.OffsetTimeOriginal ?? "America/Los_Angeles",
    })
  : null;

// Film detection
const film = meta.Make === "NORITSU KOKI" || meta.Keywords?.includes("Film");
const FilmstockKeywords = [
  "Cinestill 50D", "Ektar 100", "Kodak Gold 200", "Kodak Gold",
  "Gold 200", "Ektachrome E100", "Instax Square", "Instax Monochrome",
  "Portra 400", "Ektachrome", "Portra 160", "Candido 800", "Harman Phoenix",
];
const filmStock = film
  ? meta.Keywords?.find((k) => k && FilmstockKeywords.includes(k))
  : null;

// Compute prev/next photos in same month
const allPhotos = await getCollection("photos");
const sameGroupPhotos = allPhotos
  .filter((p) => p.data.organization.monthSlug === photo.data.organization.monthSlug)
  .sort((a, b) => new Date(b.data.dateTaken).getTime() - new Date(a.data.dateTaken).getTime());

const selfIndex = sameGroupPhotos.findIndex((p) => p.data.filename === filename);
const prevPhoto = selfIndex > 0 ? sameGroupPhotos[selfIndex - 1] : null;
const nextPhoto = selfIndex < sameGroupPhotos.length - 1 ? sameGroupPhotos[selfIndex + 1] : null;
---

<BaseLayout title="Photos" bodyClass="bg-white text-black">
  <div class="min-h-screen p-0">
    <Nav currentPath="/photos" className="mb-0" scheme="light" />
    <div class="relative p-5 md:p-8 overflow-hidden flex justify-center" id="photo-container">
      <div class="relative">
        <img
          alt={meta.ObjectName ?? `photo ${filename}`}
          class="max-h-[calc(100svh-110px)] relative z-[1]"
          id="photo"
          src={imageSrc}
        />
        <img
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-contain blur-[10px] opacity-70 z-0"
          src={imageSrc}
        />
      </div>
      {/* Build-time prev/next nav arrows */}
      <div class="absolute flex items-stretch justify-between" style="top: 0; right: 0; bottom: 0; left: 0;">
        {prevPhoto ? (
          <a
            id="nav-prev"
            class="px-4 flex items-center h-full z-10 text-black/20 backdrop-blur-0 transition hover:opacity-100 hover:backdrop-blur hover:bg-black/20 hover:text-black opacity-70"
            href={`/${prevPhoto.data.slug}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </a>
        ) : <div />}
        {nextPhoto ? (
          <a
            id="nav-next"
            class="px-4 flex items-center h-full z-10 text-black/20 backdrop-blur-0 transition hover:opacity-100 hover:backdrop-blur hover:bg-black/20 hover:text-black opacity-70"
            href={`/${nextPhoto.data.slug}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ) : <div />}
      </div>
    </div>
    <div class="flex justify-center flex-col sm:flex-row pt-0 p-6">
      <div class="px-4">
        <div class="flex flex-col items-end gap-2">
          {dateStr && (
            <div class="flex justify-end items-end mr-2 font-mono">
              <div class="flex flex-col items-end">
                <span class="text-sm opacity-60 m-0">{film ? "date" : "date taken"}</span>
                <span class="md:text-lg leading-4">{dateStr}</span>
              </div>
              <span class="ml-2 pb-2 text-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              </span>
            </div>
          )}
          {film && (
            <div class="flex justify-end items-end mr-2 font-mono">
              <div class="flex flex-col items-end">
                <span class="text-sm opacity-60 m-0">filmstock</span>
                <span class="md:text-lg leading-4">{filmStock ?? "-"}</span>
              </div>
              <span class="ml-2 pb-2 text-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"/><line x1="7" x2="7" y1="2" y2="22"/><line x1="17" x2="17" y1="2" y2="22"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="2" x2="7" y1="7" y2="7"/><line x1="2" x2="7" y1="17" y2="17"/><line x1="17" x2="22" y1="7" y2="7"/><line x1="17" x2="22" y1="17" y2="17"/></svg>
              </span>
            </div>
          )}
          {!film && meta && (shutterSpeed || meta.FNumber || meta.ISO || meta.FocalLength) && (
            <div class="flex flex-wrap justify-end gap-2 bg-gray-500/20 py-3 pl-4 rounded">
              {shutterSpeed && (
                <div class="flex justify-end items-end mr-2 font-mono">
                  <div class="flex flex-col items-end">
                    <span class="text-sm opacity-60 m-0">shutter</span>
                    <span class="md:text-lg leading-4">{shutterSpeed}</span>
                  </div>
                  <span class="ml-2 pb-2 text-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="2" y1="2" y2="10"/><line x1="22" x2="14" y1="2" y2="10"/><line x1="10" x2="2" y1="14" y2="22"/><line x1="22" x2="14" y1="14" y2="22"/></svg>
                  </span>
                </div>
              )}
              {meta.FNumber && (
                <div class="flex justify-end items-end mr-2 font-mono">
                  <div class="flex flex-col items-end">
                    <span class="text-sm opacity-60 m-0">aperture</span>
                    <span class="md:text-lg leading-4">f/{meta.FNumber}</span>
                  </div>
                  <span class="ml-2 pb-2 text-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="14.31" x2="20.05" y1="8" y2="17.94"/><line x1="9.69" x2="21.17" y1="8" y2="8"/><line x1="7.38" x2="13.12" y1="12" y2="2.06"/><line x1="9.69" x2="3.95" y1="16" y2="6.06"/><line x1="14.31" x2="2.83" y1="16" y2="16"/><line x1="16.62" x2="10.88" y1="12" y2="21.94"/></svg>
                  </span>
                </div>
              )}
              {meta.ISO && (
                <div class="flex justify-end items-end mr-2 font-mono">
                  <div class="flex flex-col items-end">
                    <span class="text-sm opacity-60 m-0">ISO</span>
                    <span class="md:text-lg leading-4">{meta.ISO}</span>
                  </div>
                  <span class="ml-2 pb-2 text-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"/><line x1="7" x2="7" y1="2" y2="22"/><line x1="17" x2="17" y1="2" y2="22"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="2" x2="7" y1="7" y2="7"/><line x1="2" x2="7" y1="17" y2="17"/><line x1="17" x2="22" y1="7" y2="7"/><line x1="17" x2="22" y1="17" y2="17"/></svg>
                  </span>
                </div>
              )}
              {meta.FocalLength && (
                <div class="flex justify-end items-end mr-2 font-mono">
                  <div class="flex flex-col items-end">
                    <span class="text-sm opacity-60 m-0">focal</span>
                    <span class="md:text-lg leading-4">{round(meta.FocalLength)}mm</span>
                  </div>
                  <span class="ml-2 pb-2 text-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2 8h3l2-2 6 6 2.3-2.3"/><path d="m14 4 6 6"/></svg>
                  </span>
                </div>
              )}
            </div>
          )}
          {!film && (meta?.Make || meta?.Model) && (
            <div class="flex justify-end items-end mr-2 font-mono">
              <div class="flex flex-col items-end">
                <span class="text-sm opacity-60 m-0">camera</span>
                <span class="md:text-lg leading-4">{[meta?.Make, meta?.Model].filter(Boolean).join(" ")}</span>
              </div>
              <span class="ml-2 pb-2 text-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              </span>
            </div>
          )}
          {!film && meta?.LensModel && meta.LensModel !== "----" && (
            <div class="flex justify-end items-end mr-2 font-mono">
              <div class="flex flex-col items-end">
                <span class="text-sm opacity-60 m-0">lens</span>
                <span class="md:text-lg leading-4">{meta.LensModel}</span>
              </div>
              <span class="ml-2 pb-2 text-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              </span>
            </div>
          )}
        </div>
      </div>
      <div class="justify-self-stretch border border-black border-opacity-10 my-4" />
      <div class="px-4 text-right sm:text-left">
        <p class="font-mono text-sm mr-2 mb-4">{filename}</p>
        <a
          class="cursor-pointer inline-block text-center font-sans mr-2 px-3 py-2 rounded text-white border-2 border-blue-500 bg-blue-600 hover:bg-blue-500 hover:border-blue-400 transition-colors"
          download
          href={imageSrc}
        >
          Download wallpaper
        </a>
      </div>
    </div>
  </div>
  <script>
    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        window.location.href = "/photos";
      } else if (e.key === "ArrowLeft") {
        const prev = document.getElementById("nav-prev") as HTMLAnchorElement | null;
        if (prev) window.location.href = prev.href;
      } else if (e.key === "ArrowRight") {
        const next = document.getElementById("nav-next") as HTMLAnchorElement | null;
        if (next) window.location.href = next.href;
      }
    });

    // Scroll photo into view
    const photoContainer = document.getElementById("photo-container");
    if (photoContainer) {
      const imgHeight = photoContainer.clientHeight;
      window.scrollTo({
        top: photoContainer.offsetTop - (window.innerHeight - imgHeight) / 2,
        behavior: "smooth",
      });
    }
  </script>
</BaseLayout>
