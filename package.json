{
  "name": "chuck-dries",
  "version": "1.0.0",
  "private": true,
  "description": "Chuck Dries",
  "author": "Chuck Dries",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "typecheck": "astro check && tsc --noEmit",
    "serve": "astro preview",
    "clean": "rm -rf .astro dist",
    "lint-fix": "eslint --fix --ext .jsx,.js src",
    "lint": "eslint --ext .jsx,.js src",
    "upload": "rsync -rz --delete dist/ ci@droplet.chuckdries.com:www/personal-website",
    "upload-staging": "rsync -rz --delete dist/ ci@droplet.chuckdries.com:www/personal-website-staging",
    "deploy": "yarn build && yarn upload",
    "pretty": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "@internationalized/date": "^3.7.0",
    "@juliangarnierorg/anime-beta": "^4.0.0",
    "@react-aria/utils": "^3.27.0",
    "@react-spring/web": "^9.7.5",
    "astro": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "bluesky-comments": "^0.9.0",
    "chroma-js": "^3.1.2",
    "classnames": "^2.5.1",
    "exifr": "^7.1.3",
    "glob": "^11.0.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.474.0",
    "postcss": "^8.5.1",
    "postcss-nested": "^6.2.0",
    "ramda": "^0.30.1",
    "react": "^18.3.1",
    "react-aria": "^3.37.0",
    "react-aria-components": "^1.6.0",
    "react-cool-dimensions": "^3.0.1",
    "react-dom": "^18.3.1",
    "react-stately": "^3.35.0",
    "react-window": "^1.8.11",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-touch": "^1.0.1",
    "use-breakpoint": "^2.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/chroma-js": "^3.1.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.10.10",
    "@types/ramda": "^0.30.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "3.4.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@4.10.3"
}
